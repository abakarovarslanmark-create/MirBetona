# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Пароль для входа во встроенную панель администратора (/admin)
ADMIN_PASSWORD="admin"

# Настройки российского почтового сервера (Яндекс 360 / Mail.ru / Timeweb) для дублирования заявок на Email
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL=""

